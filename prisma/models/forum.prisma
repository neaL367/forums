model Forum {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  id          String @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  description String

  parentForumId String?
  parentForum   Forum?  @relation("ForumToSubForums", fields: [parentForumId], references: [id])
  subForums     Forum[] @relation("ForumToSubForums")

  topics Topic[]

  @@map("forum")
}